# ==============================================================
# PLANTILLA DE CONFIGURACIÓN - COMPUNIC WEB (.env.example)
# ==============================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env' en esta misma carpeta.
# 2. Rellena las variables con tus credenciales locales/de producción.
# 3. NUNCA subas tu archivo '.env' real a GitHub.
# ==============================================================

# Puerto del servidor backend
PORT=3001

# Conexión a Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=COMPUNIC_V5
# Opcional si usas una URL directa de conexión (e.g. en la nube):
# DB_URL=mysql://root:password@localhost:3306/COMPUNIC_V5

# Aurum IA — Google Gemini
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# Autenticación JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=24h

# Servicio de Correo Electrónico (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion_gmail

# URL del Frontend (para enlaces de recuperación de contraseña y confirmaciones)
FRONTEND_URL=http://localhost:3001

# Tasa de cambio oficial de Córdobas a Dólares (BCN: 36.6243 por defecto)
TASA_CAMBIO_OFICIAL=36.6243

# Subida de imágenes externa (Opcional - ImgBB)
# IMGBB_API_KEY=tu_api_key_imgbb

# ==============================================================
# ALMACENAMIENTO EN LA NUBE - CLOUDFLARE R2 (S3 Compatible)
# ==============================================================
# Obtén estas credenciales en Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET_NAME=compunic
# URL pública del bucket (ej: https://pub-xxxxxx.r2.dev o tu dominio personalizado https://cdn.tudominio.com)
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
